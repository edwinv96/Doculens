# Copy this file to backend/.env and fill in only the providers you use.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible provider
LLM_PROVIDER=google
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Runtime paths and browser origins
DATA_DIR=./data
UPLOAD_DIR=./temp_uploads
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MAX_UPLOAD_BYTES=10485760
MAX_WEB_BYTES=2097152
RAG_MIN_RELEVANCE_SCORE=0.25
RAG_RETRIEVAL_K=12
RAG_RERANK_TOP_N=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RERANK_ENABLED=true

# Optional integrations
BRIGHT_DATA_API_KEY=
PAPER_SEARCH_API_KEY=
E2B_API_KEY=
